# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Supabase S3-compatible storage
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=

# ── MSG91 (WhatsApp + SMS reminders) ─────────────────────────────────────
# Get from https://control.msg91.com → Settings → API keys
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_SENDER_ID=
# Set to "true" to log messages instead of sending (safe for dev)
MSG91_DRY_RUN=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
# Shared secret guarding /api/cron/* endpoints
CRON_SECRET=

# Postgres direct connection (migrations only)
SUPABASE_DB_PASSWORD=
